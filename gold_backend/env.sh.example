#!/usr/bin/env bash
# Copy to env.sh in the VPS deploy directory; fill secrets locally.
export PHX_HOST=xau.9nine.tech
export HTTP_PORT=5006
export POSTGRES_USER=gold_backend
export POSTGRES_DB=gold_backend_prod
export POSTGRES_PASSWORD=
export SECRET_KEY_BASE=
export POOL_SIZE=10
# Ollama chạy cùng VPS (docker bridge 172.17.0.1) hoặc máy khác.
export OLLAMA_URL=http://172.17.0.1:11434/api/generate
export OLLAMA_MODEL=deepseek-r1:1.5b
export OLLAMA_TIMEOUT_MS=120000
# metals.dev: để trống nếu không dùng nguồn giá trả phí.
export METALS_DEV_API_KEY=
# Origin frontend được phép gọi API qua trình duyệt.
export CORS_ORIGINS=https://xau.9nine.tech
