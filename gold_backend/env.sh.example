#!/usr/bin/env bash
# Copy to env.sh in the VPS deploy directory; fill secrets locally.
export PHX_HOST=xau.9nine.tech
export HTTP_PORT=5005
export POSTGRES_USER=gold_backend
export POSTGRES_DB=xau
export POSTGRES_PASSWORD=
export SECRET_KEY_BASE=
export POOL_SIZE=10
# Ollama chạy trên VPS host. Compose ánh xạ hostname này tới đúng gateway,
# không phụ thuộc subnet động 172.x của Docker network.
export OLLAMA_URL=http://host.docker.internal:11434/api/generate
export OLLAMA_MODEL=deepseek-r1:1.5b
# Analysis and Vietnamese repair have separate receive timeouts.
export OLLAMA_TIMEOUT_MS=300000
export OLLAMA_TRANSLATION_TIMEOUT_MS=60000
export OLLAMA_NUM_PREDICT=800
# metals.dev: để trống nếu không dùng nguồn giá trả phí.
export METALS_DEV_API_KEY=
# Gold API OHLC: register at https://gold-api.com, set the key locally.
# Free-tier collector uses at most 8 requests per rolling hour; no paid plan required.
export GOLD_API_KEY=
# Browser origins allowed when UI and API are on different hosts.
# Prefer same-origin nginx (/api → :5005) so CORS is unused.
export CORS_ORIGINS=https://crypto.9nine.tech,https://xau.9nine.tech

# Telegram: set BOTH in /home/deploy_user/xauusd/env.sh on the VPS.
# Open the bot in Telegram and send /start, then use that chat's ID.
# After editing, run bash deploy.sh to recreate the API container; restart alone
# does not reload Compose environment variables. rel/env.sh.eex is not in Docker.
export TELEGRAM_BOT_TOKEN=
export TELEGRAM_CHAT_ID=
