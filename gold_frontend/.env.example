# Cấu hình server cho `next build` / `next dev`.
#
# API_BASE_URL — đích proxy server-side cho /api.
# Browser luôn gọi same-origin /api nên không phụ thuộc CORS.
# NEXT_PUBLIC_APP_URL — URL tuyệt đối của frontend (dành cho link tuyệt đối / SEO).
#
# Local dev (Next chạy trên máy, API chạy Docker publish trên host :5005):
API_BASE_URL=https://api-crypto.9nine.tech
NEXT_PUBLIC_APP_URL=http://localhost:3003
