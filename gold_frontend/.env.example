# NEXT_PUBLIC_* is inlined at next build / next dev start.
#
# Production (VPS): leave empty. Browser calls same host /api/...
# nginx: /api/ → 127.0.0.1:5005 (gold_backend). Never use api-crypto.
# NEXT_PUBLIC_API_URL=
#
# Local Next → gold API on the host (docker publish 5005→container 4000):
NEXT_PUBLIC_API_URL=https://api-crypto.9nine.tech
