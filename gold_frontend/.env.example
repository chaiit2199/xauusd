# Các biến được nhúng vào bundle tại `next build` / `next dev`.
#
# API_BASE_URL — đích gọi API gold backend:
#   * Rỗng: browser gọi same-origin /api (VPS: Caddy/nginx → :5005).
#   * Đầy đủ: ví dụ https://api-crypto.9nine.tech — backend phải mở CORS cho origin này.
# NEXT_PUBLIC_APP_URL — URL tuyệt đối của frontend (dành cho link tuyệt đối / SEO).
#
# Local dev (Next chạy trên máy, API chạy Docker publish trên host :5005):
API_BASE_URL=https://api-crypto.9nine.tech
NEXT_PUBLIC_APP_URL=http://localhost:3003
