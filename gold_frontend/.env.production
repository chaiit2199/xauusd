# Dùng bởi `npm run build` / `npm run start` trên VPS.
# API_BASE_URL rỗng = same-origin (/api → Caddy/nginx → :5005).
# Muốn gọi thẳng https://api-crypto.9nine.tech: đặt API_BASE_URL trong .env.local
# của VPS (giá trị ở đây bị .env.local đè) và mở CORS ở backend cho origin trang web.
API_BASE_URL=
